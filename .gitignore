# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# --- Minitab 运行时产物（不入库；由运行自动生成） ---
runtime/knowledge/experience.db
runtime/knowledge/*.db-journal
runtime/artifacts/
runtime/outputs/
runtime/generated_macros/
runtime/evidence/*.log
scripts/knowledge/*.db

# --- 宏库索引（可由 `minitab_cli.py macro --reindex` 重建） ---
macros/index.json

# --- 大文件 / 第三方版权资料（按需取舍，见 README 说明） ---
